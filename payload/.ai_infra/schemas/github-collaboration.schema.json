{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-kit.local/schemas/github-collaboration.schema.json",
  "title": "GitHubCollaboration",
  "type": "object",
  "required": ["version", "owner", "commit_provenance", "pr_collaboration"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "object",
      "required": ["display_name", "github_user"],
      "additionalProperties": true,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "github_user": { "type": "string", "minLength": 1 }
      }
    },
    "project_ssot": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "default_repo": { "type": "string" },
        "tool": { "type": "string", "enum": ["gh", "mcp"] },
        "sync_policy": {
          "type": "string",
          "enum": ["board_only", "board_first", "offline_fallback"]
        },
        "fallback": { "type": "string", "enum": ["local_trackers", "none"] },
        "fields": { "type": "object", "additionalProperties": true },
        "conventions": { "type": "object", "additionalProperties": true },
        "local_only": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "commit_provenance": {
      "type": "object",
      "required": ["ai_disclosure_mode"],
      "additionalProperties": true,
      "properties": {
        "ai_disclosure_mode": {
          "type": "string",
          "enum": ["assisted_by", "co_author_trailer", "none"]
        },
        "assisted_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool"],
            "additionalProperties": true,
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "model": { "type": ["string", "null"] },
              "agent": { "type": ["string", "null"] }
            }
          }
        },
        "human_coauthors": { "type": "array" },
        "forbid_in_commits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "co_author_trailer": { "type": "object" }
      }
    },
    "pr_collaboration": {
      "type": "object",
      "required": ["pipelines"],
      "additionalProperties": true,
      "properties": {
        "pipelines": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["agents"],
            "additionalProperties": true,
            "properties": {
              "agents": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "requires_alignment_artifacts": { "type": "boolean" },
              "session_pointer": { "type": "string" }
            }
          }
        },
        "collaborators": { "type": "object" },
        "pr_body": { "type": "object" }
      }
    }
  }
}
