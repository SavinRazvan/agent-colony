{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colony.local/schemas/debug/modules.schema.json",
  "title": "DebugModules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "importance",
          "status",
          "file_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "importance": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
