{
  "version": 1,
  "profiles": {
    "default": {
      "required_paths": [
        ".cursor/agents/implementer.md",
        ".ai_infra/scripts/pr/prepare.py",
        ".ai_infra/scripts/architecture/check_governance_consistency.py",
        ".ai_infra/bootstrap.py",
        ".ai_infra/paths.py",
        ".ai_infra/manifest.yaml",
        ".local/index-and-planning/current/session-pointer.md",
        "AGENTS.md",
        "agent_colony/__main__.py",
        ".ai_infra/install/agent_colony/cli.py"
      ],
      "forbidden_paths": [
        "examples",
        "tests/modules/install/test_scaffold.py",
        ".cursor/agents/workflow-intelligence-mapper.md"
      ],
      "recommended_paths": [
        ".local/workflow-artifacts/pr/README.md",
        ".local/workflow-artifacts/alignment/README.md",
        ".local/workflow-artifacts/drift/README.md",
        ".local/workflow-artifacts/enterprise-architecture-audit/README.md",
        ".local/workflow-artifacts/release/README.md",
        ".local/workflow-artifacts/audit/README.md"
      ],
      "kit_managed_globs": [
        ".cursor/agents/auditor.md",
        ".cursor/agents/board.md",
        ".cursor/agents/drift-guard.md",
        ".cursor/agents/implementer.md",
        ".cursor/agents/integrator.md",
        ".cursor/agents/researcher.md",
        ".cursor/agents/test-runner.md",
        ".cursor/agents/verifier.md",
        ".cursor/skills/**",
        ".cursor/rules/**",
        ".ai_infra/**",
        "agent_colony/**"
      ]
    },
    "with_mcp": {
      "extends": "default",
      "required_paths": [
        ".ai_infra/mcp_servers/agent_colony_mcp/server.py",
        "requirements-mcp.txt"
      ],
      "forbidden_paths": []
    },
    "consumer_lite": {
      "extends": "with_mcp",
      "required_paths": [
        ".cursor/agents/board.md",
        ".cursor/agents/implementer.md",
        ".cursor/agents/verifier.md",
        ".cursor/skills/board-ssot/SKILL.md",
        ".cursor/skills/workflow-activate/SKILL.md",
        ".agents/skills/review-pr/SKILL.md",
        ".local/generated-data/install-profile.json"
      ],
      "forbidden_paths": [
        ".cursor/agents/auditor.md",
        ".cursor/agents/researcher.md",
        ".cursor/skills/board-shell/SKILL.md",
        ".agents/skills/audit-alignment/SKILL.md"
      ]
    }
  }
}
