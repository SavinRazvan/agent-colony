{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-kit.local/schemas/github-collaboration.schema.json",
  "title": "GitHubCollaboration",
  "type": "object",
  "required": ["version", "owner", "commit_provenance", "pr_collaboration"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "object",
      "required": ["display_name", "github_user"],
      "additionalProperties": true,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "github_user": { "type": "string", "minLength": 1 }
      }
    },
    "project_ssot": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "default_repo": { "type": "string" },
        "tool": { "type": "string", "enum": ["gh", "mcp"] },
        "sync_policy": {
          "type": "string",
          "enum": ["board_only", "board_first", "offline_fallback"]
        },
        "fallback": { "type": "string", "enum": ["local_trackers", "none"] },
        "outbox": {
          "type": "object",
          "additionalProperties": true,
          "description": "Local JSONL buffer for board writes when GraphQL is rate-limited or precheck fails (not a second SSOT). EXIT_QUEUED=6 = soft-success; do not retry-loop.",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": {
              "type": "string",
              "description": "Repo-relative path to board-outbox.jsonl"
            },
            "min_graphql_remaining": {
              "type": "integer",
              "minimum": 0,
              "description": "Refuse flush / precheck-queue when GraphQL remaining is below this"
            },
            "max_flush_per_run": {
              "type": "integer",
              "minimum": 1,
              "description": "Max pending ops applied per outbox flush"
            },
            "retry_backoff_seconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Sleep between flush ops after soft failures"
            },
            "precheck_writes": {
              "type": "boolean",
              "description": "Cached REST rate_limit probe before Pattern A writes (default true)"
            },
            "quota_cache_ttl_seconds": {
              "type": "integer",
              "minimum": 0,
              "description": "TTL for GraphQL remaining cache; avoids REST spam"
            },
            "quota_cache_path": {
              "type": "string",
              "description": "Repo-relative path to graphql-quota-cache.json"
            },
            "dedupe_pending": {
              "type": "boolean",
              "description": "Reuse one pending outbox row for identical op+item+payload"
            }
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": true,
          "description": "Project V2 field ids; status/priority/size use options; start_date/end_date/estimate use field_id only",
          "properties": {
            "status": { "type": "object", "additionalProperties": true },
            "priority": { "type": "object", "additionalProperties": true },
            "size": { "type": "object", "additionalProperties": true },
            "start_date": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "field_id": { "type": "string", "minLength": 1 }
              }
            },
            "end_date": {
              "type": "object",
              "additionalProperties": true,
              "description": "Reserved; no CLI write in Tier-1",
              "properties": {
                "field_id": { "type": "string", "minLength": 1 }
              }
            },
            "estimate": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "field_id": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "conventions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "queue_status": { "type": "string" },
            "active_status": { "type": "string" },
            "review_status": { "type": "string" },
            "done_status": { "type": "string" },
            "claim": { "type": "string" },
            "set_start_date_on_claim": {
              "type": "boolean",
              "description": "When true and fields.start_date.field_id set, write UTC YYYY-MM-DD on claim and on first transition to in_progress (set-status / handoff) if Start date is empty"
            },
            "one_in_progress_per_assignee": { "type": "boolean" },
            "item_kind_default": {
              "type": "string",
              "description": "Default card kind on create: issue (product default — gh issue create + item-add; Assignees + Linked PRs) or draft (DraftIssue scratch-only)"
            },
            "promote_to_issue_on_pr": {
              "type": "boolean",
              "description": "When true (default), mention-pr auto-promotes Draft via convertProjectV2DraftIssueItemToIssue; FAIL if promote fails. WARN-only when false."
            },
            "attribution_format": {
              "type": "string",
              "description": "Template for Notes prefix; rendered as @github_user/agent"
            },
            "require_attribution_on_exit": {
              "type": "boolean",
              "description": "When true, project append-notes requires --agent"
            },
            "body_sections": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "local_only": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "commit_provenance": {
      "type": "object",
      "required": ["ai_disclosure_mode"],
      "additionalProperties": true,
      "properties": {
        "ai_disclosure_mode": {
          "type": "string",
          "enum": ["assisted_by", "co_author_trailer", "none"]
        },
        "assisted_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool"],
            "additionalProperties": true,
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "model": { "type": ["string", "null"] },
              "agent": { "type": ["string", "null"] }
            }
          }
        },
        "human_coauthors": { "type": "array" },
        "forbid_in_commits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "co_author_trailer": { "type": "object" }
      }
    },
    "pr_collaboration": {
      "type": "object",
      "required": ["pipelines"],
      "additionalProperties": true,
      "properties": {
        "pipelines": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["agents"],
            "additionalProperties": true,
            "properties": {
              "agents": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "requires_alignment_artifacts": { "type": "boolean" },
              "session_pointer": { "type": "string" }
            }
          }
        },
        "collaborators": { "type": "object" },
        "pr_body": { "type": "object" }
      }
    }
  }
}
