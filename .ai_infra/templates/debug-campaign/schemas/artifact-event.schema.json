{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-colony.local/schemas/debug/artifact-event.schema.json",
  "title": "DebugArtifactEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "skill_id",
    "path",
    "bytes",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "timestamp": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string"
    }
  }
}
